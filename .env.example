# Port the web server listens on
PORT=3000
# Where uploaded images are stored (YYYY/MM/ProjectName/ sub-folders are created automatically)
UPLOAD_DIR=./uploads
# Public origin that email recipients can reach; used to make /uploads/... image URLs absolute on export.
# Leave blank to use the origin of the browser request.
PUBLIC_BASE_URL=https://email-assets.your-school.example
# Uploaded images wider than this are downscaled (px). 1200 = sharp on hi-DPI screens for a 600px email.
MAX_IMAGE_WIDTH=1200
# JPEG compression quality (1-100)
JPEG_QUALITY=82
# SQLite database for accounts, sessions and templates (default: swiftwing.db next to UPLOAD_DIR, or ./data/swiftwing.db;
# an existing atelier.db in that folder is used instead)
# DB_PATH=/var/lib/atelier-email-builder/atelier.db
# Which reverse proxies to trust for the client IP (X-Forwarded-For) and HTTPS (X-Forwarded-Proto).
# Default trusts proxies on private networks; set your Caddy IP to be stricter.
# TRUST_PROXY=10.50.0.10
