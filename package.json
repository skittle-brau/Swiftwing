{
  "name": "swiftwing",
  "version": "1.0.0",
  "description": "WYSIWYG drag-and-drop HTML email builder with XHTML 1.0 Transitional, CSS-inlined, table-based export (Synergetic / Outlook compatible).",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test test/*.test.js",
    "user": "node --env-file-if-exists=.env server/cli.js user",
    "synergetic-tests": "node scripts/build-synergetic-tests.js",
    "synergetic-compare": "node scripts/synergetic-compare.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "entities": "^8.1.0",
    "express": "^5.3.0",
    "juice": "^12.2.1",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "tinymce": "^8.10.1"
  }
}
